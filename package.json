{
  "name": "berlin-transit-heatmap",
  "private": true,
  "version": "0.9.1",
  "description": "How long does it take to get anywhere in Berlin by public transport? A travel-time heatmap.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && vitest run scripts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "build-timetable": "node packages/timetable-build/bin/build-timetable.js",
    "gtfs:fetch": "sh scripts/gtfs/fetch.sh",
    "gtfs:verify": "node scripts/gtfs/verify.mjs data/gtfs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "globals": "^17.13.0",
    "playwright-core": "1.56.1",
    "prettier": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
