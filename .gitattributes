# Normalize line endings; bash scripts must stay LF or hooks break on Windows.
# Synced from project-templates (sync_template.py): this repo's own lines go between the local markers.
* text=auto eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
.githooks/* text eol=lf
# >>> local: this repo's own attributes (later lines win)
# Every text file is checked out with LF line endings, also where core.autocrlf=true
# (Git for Windows' default): the web build reads index.html line by line and prettier
# wants LF (S062). Bash scripts break on Windows with CRLF anyway.
# <<< local
